# ================================================================
# Private AI Search Engine - Environment Configuration
# ================================================================

# --- Groq Cloud Inference (Optional, for ultra-fast cloud LLM) ---
# Obtain from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Ollama Local Inference (Optional, for 100% offline LLM) ---
# Default host for local installations
OLLAMA_BASE_URL=http://localhost:11434

# --- Search Engine Settings ---
# Leave blank to use DuckDuckGo (zero config, untracked).
# Or provide your self-hosted SearXNG URL (e.g. http://localhost:8080):
SEARXNG_URL=
